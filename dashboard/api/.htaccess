# QuickLimes API — never serve the secrets file or the SQL dump as plain text.
<FilesMatch "^(config\.php|config\.example\.php|schema\.sql)$">
  Require all denied
</FilesMatch>

# Pass the Authorization header through to PHP (LiteSpeed/CGI can strip it).
# The API also accepts the token in the body / query, so this is belt-and-suspenders.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Clean API URLs: /api/foo → /api/foo.php (internal rewrite, no redirect —
  # the API is POSTed to, so a 301 would drop the request body). Existing
  # /api/foo.php URLs keep working unchanged.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([A-Za-z0-9_-]+)$ $1.php [L]
</IfModule>
